            ? `<a href="${esc(m.workflow_run_url)}" target="_blank">${esc(st)}</a>`
            : esc(st);
          html += `<tr>
            <td><a href="${esc(m.url)}" target="_blank">#${esc(m.pr)}</a></td>
            <td>${esc(m.title)}</td>
            <td>${esc(m.author)}</td>
            <td>${esc((m.merged_at||'').slice(0,10))}</td>
            <td><span class="status status-${esc(st)}">${runLink}</span></td>
          </tr>`;
        }
        html += `</tbody></table>`;
      }
      html += `</div>`;
    }
    div.innerHTML = html;
    root.appendChild(div);
  }
}

const filterInput = document.getElementById('filter');
const statusSelect = document.getElementById('status-filter');
filterInput.addEventListener('input', () => render(filterInput.value, statusSelect.value));
statusSelect.addEventListener('change', () => render(filterInput.value, statusSelect.value));
