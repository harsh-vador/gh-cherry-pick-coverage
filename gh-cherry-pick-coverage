    for (const b of repo.branches) {
      const missing = (b.missing || []).filter(m => {
        if (statusFilter && m.last_workflow_status !== statusFilter) return false;
        if (!filter) return true;
        return (m.title + ' ' + m.author + ' #' + m.pr).toLowerCase().includes(filter);
