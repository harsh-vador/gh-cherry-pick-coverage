#!/usr/bin/env python3
"""gh-cherry-pick-coverage — audit missing cherry-picks from main to release branches.

Usage examples
--------------

  # one repo, one branch
  gh cherry-pick-coverage --repo open-metadata/openmetadata-collate --branch 1.13

  # multi-repo, multi-branch, open dashboard when done
  gh cherry-pick-coverage \\
    --repo open-metadata/openmetadata-collate \\
    --repo open-metadata/OpenMetadata \\
    --branch 1.13 --branch 1.12.10 \\
    --open

Detection: a PR labeled `--label` (default 'To release') and merged into main
after the release branch was cut is considered MISSING on that branch unless:
  - the merge commit is an ancestor of the branch, OR
  - the branch contains a commit with `(cherry picked from commit <M>)`, OR
  - the branch contains a commit whose subject ends with `(#<PR>)`.

Requires `gh` CLI on PATH and authenticated (`gh auth login`). Stdlib only.
"""
from __future__ import annotations

import argparse
import base64
import json
import logging
import os
import shutil
import subprocess
import sys
import tempfile
import webbrowser
from dataclasses import asdict, dataclass, field
from datetime import datetime, timezone
from pathlib import Path

LOG = logging.getLogger("cpc")
CHERRY_PICK_WORKFLOW = "auto-cherry-pick-labeled-prs.yaml"
PR_LIST_LIMIT = 1000

DEFAULT_REPOS = [
    "open-metadata/openmetadata-collate",
    "open-metadata/OpenMetadata",
    "open-metadata/ai-platform",
    "open-metadata/collate-hybrid-ingestion-runner",
]


# ───────────────────────────────────────────── interactive prompts ─────


def _stdin_is_tty() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


def prompt_multi_select(label: str, options: list[str]) -> list[str]:
    """Numbered multi-select. '1,3' -> options[0] + options[2]. 'a'/'all' -> all."""
    print(f"\n{label}")
    for i, opt in enumerate(options, 1):
        print(f"  {i}) {opt}")
    while True:
        try:
            raw = input("> ").strip().lower()
        except EOFError:
            print("aborted (EOF)", file=sys.stderr)
            sys.exit(2)
        if not raw:
            print("at least one selection required", file=sys.stderr)
            continue
        if raw in ("a", "all"):
            return list(options)
        try:
            idxs = [int(x.strip()) for x in raw.split(",") if x.strip()]
        except ValueError:
            print("invalid input — enter numbers like '1,3' or 'a' for all", file=sys.stderr)
            continue
        if not all(1 <= i <= len(options) for i in idxs):
            print(f"numbers must be between 1 and {len(options)}", file=sys.stderr)
            continue
        return [options[i - 1] for i in idxs]


def prompt_text(label: str) -> str:
    while True:
        try:
            raw = input(f"{label}\n> ").strip()
        except EOFError:
            print("aborted (EOF)", file=sys.stderr)
            sys.exit(2)
        if raw:
            return raw
        print("value required", file=sys.stderr)


def prompt_yes_no(label: str, default: bool = False) -> bool:
    suffix = " [Y/n]" if default else " [y/N]"
    try:
        raw = input(f"{label}{suffix}: ").strip().lower()
    except EOFError:
        return default
    if not raw:
        return default
    return raw in ("y", "yes")


# ───────────────────────────────────────────── data classes ─────


@dataclass
class MissingPR:
    pr: int
    title: str
    author: str
    merged_at: str
    url: str
    merge_commit: str
    last_workflow_status: str = "unknown"
    workflow_run_url: str = ""


@dataclass
class BranchReport:
    name: str
    missing: list[MissingPR] = field(default_factory=list)
    error: str = ""


@dataclass
class RepoReport:
    name: str
    branches: list[BranchReport] = field(default_factory=list)
    error: str = ""


# ───────────────────────────────────────────── shell helpers ─────


def run(cmd: list[str], cwd: str | None = None, check: bool = True) -> str:
    LOG.debug("run: %s", " ".join(cmd))
    res = subprocess.run(cmd, cwd=cwd, check=check, capture_output=True, text=True)
    return res.stdout


def gh_json(args: list[str]):
    out = run(["gh"] + args)
    return json.loads(out) if out.strip() else None


def _parse_iso(ts: str) -> datetime | None:
    if not ts:
        return None
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None


# ───────────────────────────────────────────── git ─────


def _auth_header() -> list[str]:
    """Token passed via ephemeral http header so it never persists in .git/config."""
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if not token:
        try:
            token = run(["gh", "auth", "token"]).strip()
        except subprocess.CalledProcessError:
            token = ""
    if not token:
        return []
    basic = base64.b64encode(f"x-access-token:{token}".encode()).decode()
    return ["-c", f"http.extraheader=Authorization: Basic {basic}"]


def clone_repo(repo: str, workdir: Path) -> Path:
    target = workdir / repo.replace("/", "_")
    if target.exists():
        return target
    url = f"https://github.com/{repo}.git"
    auth = _auth_header()
    run(["git", *auth, "clone", "--filter=blob:none", "--no-checkout", url, str(target)])
    return target


def fetch_refs(repo_dir: Path, branches: list[str]) -> None:
    refs = ["main"] + branches
    auth = _auth_header()
    cmd = ["git", *auth, "fetch", "--no-tags", "origin"] + [
        f"+refs/heads/{b}:refs/remotes/origin/{b}" for b in refs
    ]
    run(cmd, cwd=str(repo_dir), check=False)


def branch_exists(repo_dir: Path, branch: str) -> bool:
    res = subprocess.run(
        ["git", "rev-parse", "--verify", f"refs/remotes/origin/{branch}"],
        cwd=str(repo_dir), capture_output=True, text=True,
    )
    return res.returncode == 0


def branch_creation_date(repo_dir: Path, branch: str) -> str | None:
    try:
        base = run(["git", "merge-base", f"origin/{branch}", "origin/main"], cwd=str(repo_dir)).strip()
        if not base:
            return None
        return run(["git", "show", "-s", "--format=%cI", base], cwd=str(repo_dir)).strip()
    except subprocess.CalledProcessError:
        return None


def cherry_pick_present(repo_dir: Path, branch: str, merge_sha: str, pr_number: int) -> bool:
    if merge_sha:
        anc = subprocess.run(
            ["git", "merge-base", "--is-ancestor", merge_sha, f"origin/{branch}"],
            cwd=str(repo_dir), capture_output=True,
        )
        if anc.returncode == 0:
            return True
        grep = subprocess.run(
            ["git", "log", f"origin/{branch}",
             "--grep", f"cherry picked from commit {merge_sha}",
             "--fixed-strings", "--format=%H"],
            cwd=str(repo_dir), capture_output=True, text=True,
        )
        if grep.stdout.strip():
            return True
    # Subject-line-only PR# match (avoids body-reference false positives).
    log_out = subprocess.run(
        ["git", "log", f"origin/{branch}", "--format=%H %s"],
        cwd=str(repo_dir), capture_output=True, text=True,
    )
    suffix = f"(#{pr_number})"
    for line in log_out.stdout.splitlines():
        _, _, subject = line.partition(" ")
        if subject.rstrip().endswith(suffix):
            return True
    return False


# ───────────────────────────────────────────── GitHub queries ─────


def list_labeled_merged_prs(
    repo: str, label: str, since: str | None, author: str | None = None,
) -> list[dict]:
    args = ["pr", "list", "--repo", repo, "--state", "merged", "--base", "main",
            "--label", label, "--limit", str(PR_LIST_LIMIT),
            "--json", "number,title,author,mergedAt,url,mergeCommit,headRefOid"]
    if since:
        args += ["--search", f"merged:>={since}"]
    if author:
        args += ["--author", author]
    data = gh_json(args) or []
    if len(data) >= PR_LIST_LIMIT:
        LOG.warning("PR list for %s hit --limit=%d; results may be truncated.",
                    repo, PR_LIST_LIMIT)
    return data


_WF_RUN_CACHE: dict[tuple[str, str], dict[str, dict]] = {}


def _workflow_runs_by_sha(repo: str, since: str | None) -> dict[str, dict]:
    key = (repo, since or "")
    if key in _WF_RUN_CACHE:
        return _WF_RUN_CACHE[key]
    by_sha: dict[str, dict] = {}
    qs = "per_page=100"
    if since:
        qs += f"&created=%3E%3D{since}"
    try:
        out = run(["gh", "api", "--paginate",
                   f"repos/{repo}/actions/workflows/{CHERRY_PICK_WORKFLOW}/runs?{qs}",
                   "--jq", ".workflow_runs[] | {id, head_sha, conclusion, html_url, created_at}"])
        for line in out.splitlines():
            line = line.strip()
            if not line:
                continue
            entry = json.loads(line)
            sha = entry.get("head_sha")
            if not sha:
                continue
            existing = by_sha.get(sha)
            if not existing or (entry.get("created_at") or "") > (existing.get("created_at") or ""):
                by_sha[sha] = entry
    except subprocess.CalledProcessError as e:
        LOG.debug("Workflow runs unavailable for %s: %s", repo, e.stderr)
    _WF_RUN_CACHE[key] = by_sha
    return by_sha


def latest_workflow_run_for_pr(repo: str, sha: str, since: str | None) -> tuple[str, str]:
    if not sha:
        return ("not_run", "")
    entry = _workflow_runs_by_sha(repo, since).get(sha)
    if not entry:
        return ("not_run", "")
    return (entry.get("conclusion") or "in_progress", entry.get("html_url") or "")


# ───────────────────────────────────────────── core ─────


def process_repo(
    repo: str, branches: list[str], label: str, workdir: Path,
    author: str | None = None,
) -> RepoReport:
    report = RepoReport(name=repo)
    LOG.info("Processing %s (branches=%s)", repo, branches)
    try:
        repo_dir = clone_repo(repo, workdir)
        fetch_refs(repo_dir, branches)
    except subprocess.CalledProcessError as e:
        report.error = f"clone/fetch failed: {e.stderr.strip() if e.stderr else e}"
        return report

    earliest_ts = None
    for b in branches:
        if not branch_exists(repo_dir, b):
            continue
        ts = branch_creation_date(repo_dir, b)
        if ts and (earliest_ts is None or ts < earliest_ts):
            earliest_ts = ts
    since_date = earliest_ts[:10] if earliest_ts else None

    try:
        prs = list_labeled_merged_prs(repo, label, since_date, author=author)
    except subprocess.CalledProcessError as e:
        report.error = f"gh pr list failed: {e.stderr.strip() if e.stderr else e}"
        return report

    for b in branches:
        br = BranchReport(name=b)
        if not branch_exists(repo_dir, b):
            br.error = "branch not found on remote"
            report.branches.append(br)
            continue
        b_created_dt = _parse_iso(branch_creation_date(repo_dir, b) or "")
        for pr in prs:
            merged_dt = _parse_iso(pr.get("mergedAt") or "")
            if b_created_dt and merged_dt and merged_dt < b_created_dt:
                continue
            merge_commit = (pr.get("mergeCommit") or {}).get("oid", "")
            if cherry_pick_present(repo_dir, b, merge_commit, pr["number"]):
                continue
            conclusion, run_url = latest_workflow_run_for_pr(
                repo, pr.get("headRefOid", ""), since_date,
            )
            br.missing.append(MissingPR(
                pr=pr["number"], title=pr.get("title", ""),
                author=(pr.get("author") or {}).get("login", ""),
                merged_at=pr.get("mergedAt") or "",
                url=pr.get("url", ""),
                merge_commit=merge_commit,
                last_workflow_status=conclusion,
                workflow_run_url=run_url,
            ))
        report.branches.append(br)
    return report


