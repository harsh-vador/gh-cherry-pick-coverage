def render_dashboard(report: dict, out_path: Path) -> None:
    payload = (
        json.dumps(report)
        .replace("<", "\\u003c")
        .replace(">", "\\u003e")
        .replace("&", "\\u0026")
        .replace(chr(0x2028), "\\u2028")
        .replace(chr(0x2029), "\\u2029")
    )
    out_path.write_text(HTML_TEMPLATE.replace("__DATA__", payload))


# ───────────────────────────────────────────── CLI ─────


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="gh cherry-pick-coverage",
        description="Audit missing cherry-picks from main to release branches.",
    )
    ap.add_argument("--repo", action="append", metavar="OWNER/REPO",
                    help="Repository to audit (repeat for multiple). Omit to pick interactively.")
    ap.add_argument("--branch", action="append", metavar="BRANCH",
                    help="Release branch to audit (repeat for multiple). Omit to pick interactively.")
    ap.add_argument("--label", default="To release",
                    help="PR label that marks a PR for cherry-pick (default: %(default)r).")
    author_grp = ap.add_mutually_exclusive_group()
    author_grp.add_argument("--mine", action="store_true",
                            help="Only show PRs you authored (shortcut for --author @me).")
    author_grp.add_argument("--author", metavar="USER",
                            help="Only show PRs authored by USER (GitHub login or @me).")
    ap.add_argument("--out", type=Path, default=Path("cherry-pick-coverage.html"),
                    help="HTML output path (default: %(default)s).")
    ap.add_argument("--json", type=Path, default=None,
                    help="Also write report JSON to this path.")
    ap.add_argument("--workdir", type=Path, default=None,
                    help="Persistent clone cache dir (default: temp, slower on repeat).")
    ap.add_argument("--open", dest="open_browser", action="store_true",
                    help="Open the HTML report in the default browser when done.")
    ap.add_argument("-v", "--verbose", action="store_true")
    args = ap.parse_args(argv)

    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
    )

    # Pre-flight: gh + git on PATH, gh authed.
    for tool in ("gh", "git"):
        if shutil.which(tool) is None:
            print(f"error: {tool!r} not found on PATH", file=sys.stderr)
            return 2
    try:
        run(["gh", "auth", "status"], check=True)
    except subprocess.CalledProcessError:
        print("error: gh is not authenticated. Run `gh auth login`.", file=sys.stderr)
        return 2

    # Resolve --mine to --author @me.
    author = args.author or ("@me" if args.mine else None)

    # Interactive fallback: only when both --repo and --branch are missing AND
    # stdin is a TTY. Scripted / piped use still requires explicit flags.
    if not args.repo and not args.branch:
        if not _stdin_is_tty():
            print("error: --repo and --branch required for non-interactive use",
                  file=sys.stderr)
            return 2
        args.repo = prompt_multi_select(
            "Select repos (comma-separated numbers, 'a' for all):", DEFAULT_REPOS,
        )
        branches_in = prompt_text(
            "Branches (comma-separated, e.g. 1.13,1.12.10):",
        )
        args.branch = [b.strip() for b in branches_in.split(",") if b.strip()]
        if not args.branch:
            print("error: at least one branch required", file=sys.stderr)
            return 2
        if author is None and prompt_yes_no("Only show your own PRs?", default=False):
            author = "@me"
    elif not args.repo or not args.branch:
        print("error: --repo and --branch must both be set (or both omitted for "
              "interactive mode)", file=sys.stderr)
        return 2

    if author == "@me":
        try:
            me = run(["gh", "api", "user", "--jq", ".login"]).strip()
            if me:
                LOG.info("Filtering to PRs authored by %s", me)
        except subprocess.CalledProcessError:
            pass

    tmp = None
    if args.workdir:
        args.workdir.mkdir(parents=True, exist_ok=True)
        workdir = args.workdir
    else:
        tmp = tempfile.mkdtemp(prefix="cpc-")
        workdir = Path(tmp)

    try:
        repos = [
            process_repo(r, args.branch, args.label, workdir, author=author)
            for r in args.repo
        ]
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)

    report = {
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "repos": [
            {
                "name": r.name, "error": r.error,
                "branches": [
                    {"name": br.name, "error": br.error,
                     "missing": [asdict(m) for m in br.missing]}
                    for br in r.branches
                ],
            } for r in repos
        ],
    }

    args.out.parent.mkdir(parents=True, exist_ok=True)
    render_dashboard(report, args.out)
    if args.json:
        args.json.parent.mkdir(parents=True, exist_ok=True)
        args.json.write_text(json.dumps(report, indent=2))

    total = sum(len(b["missing"]) for r in report["repos"] for b in r["branches"])
    print(f"\nDashboard: {args.out}")
    print(f"Total missing PRs: {total}")
    for r in report["repos"]:
        if r["error"]:
            print(f"  [!] {r['name']}: {r['error'].splitlines()[0]}")
            continue
        for b in r["branches"]:
            tag = f" [{b['error']}]" if b["error"] else ""
            print(f"  {r['name']:<50} {b['name']:<10} {len(b['missing']):>4} missing{tag}")

    if args.open_browser:
        webbrowser.open(args.out.resolve().as_uri())

    return 0


if __name__ == "__main__":
    sys.exit(main())
