        html += `<div class="error">${esc(b.error)}</div>`;
      } else if (count === 0) {
        html += `<div class="empty">All caught up.</div>`;
      } else {
        html += `<table><thead><tr><th>PR</th><th>Title</th><th>Author</th>
                 <th>Merged</th><th>Last cherry-pick run</th></tr></thead><tbody>`;
